        "json": "{\n  \"$defs\": {\n    \"hex96\": {\n      \"pattern\": \"^[0-9a-f]{96}$\",\n      \"type\": \"string\"\n    },\n    \"lost\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"process\": {\n          \"pattern\": \"^[0-9a-f]{16}$\",\n          \"type\": \"string\"\n        },\n        \"since\": {\n          \"maximum\": 9007199254740991,\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"total\": {\n          \"maximum\": 9007199254740991,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"process\",\n        \"since\",\n        \"total\"\n      ],\n      \"type\": \"object\"\n    },\n    \"pseudonym\": {\n      \"pattern\": \"^p1\\\\.[0-9]{6}\\\\.[A-Za-z0-9_\\\\-]{22}$\",\n      \"type\": \"string\"\n    },\n    \"reason\": {\n      \"pattern\": \"^[A-Za-z][A-Za-z0-9_.:\\\\-]{0,63}$\",\n      \"type\": \"string\"\n    },\n    \"text\": {\n      \"maxLength\": 1024,\n      \"minLength\": 1,\n      \"type\": \"string\"\n    },\n    \"user_uid\": {\n      \"pattern\": \"^(unknown|p1\\\\.[0-9]{6}\\\\.[A-Za-z0-9_\\\\-]{22})$\",\n      \"type\": \"string\"\n    }\n  },\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\"\n}\n"
